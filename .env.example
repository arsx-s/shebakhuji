# Shebashathi backend configuration contract (not used by the current static MVP)
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./data/shebashathi.sqlite
MYSQL_URL=

# Authentication provider adapters
AUTH_MODE=development
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Map and geocoding adapters
# MAP_STYLE_URL is the MapLibre style document (style JSON) that supplies the
# basemap. It is read by the server and handed to the browser via
# GET /api/public/config — never hardcoded in the client.
#   unset   -> development default, the keyless OpenFreeMap style (documented
#              in README.md; needs internet access, no account required)
#   a URL   -> that style is used as-is (MapTiler, Protomaps, your own tiles,
#              or a country extract). Put any provider token in the URL and
#              keep this file out of version control.
#   none    -> the map is switched off and the client shows its
#              map-unavailable state (address entry still works).
MAP_PROVIDER=none
MAP_STYLE_URL=
MAP_ACCESS_TOKEN=
# Attribution string rendered on the map alongside the style's own attribution.
MAP_ATTRIBUTION=
GEOCODER_PROVIDER=none
GEOCODER_API_KEY=

# Address search (Nominatim-compatible, proxied by the server)
# Set to a Nominatim-compatible base URL to enable address search + reverse geocoding.
# Default (unset): disabled, returns 501 GEOCODE_DISABLED; the picker keeps manual entry.
# Example: https://nominatim.openstreetmap.org
# Usage policy: max 1 request/second; the server throttles and caches accordingly.
MAP_GEOCODE_URL=
# Identifying User-Agent sent to the geocoding provider (required by Nominatim).
MAP_GEOCODE_AGENT=ShebaShathi/1.0 (+https://github.com/arsx-s/shebakhuji)

# Realtime, uploads, and optional payments
REALTIME_PROVIDER=none
REALTIME_URL=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
PAYMENT_PROVIDER=cash
PAYMENT_API_KEY=
